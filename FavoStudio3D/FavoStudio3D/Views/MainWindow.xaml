<Window x:Class="FavoStudio3D.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Favo Studio 3D - Boas-vindas" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">

    <!-- Grid Principal com a imagem de fundo definida como ImageBrush -->
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Images/ImagemTelaInicio.png" Stretch="UniformToFill" AlignmentY="Center"/>
        </Grid.Background>

        <Grid>
            <!-- Divisão responsiva da tela: 55% esquerda, 45% direita -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5.5*" />
                <ColumnDefinition Width="4.5*" />
            </Grid.ColumnDefinitions>

            <!-- Card centralizado na coluna da direita -->
            <Border Grid.Column="1" Width="400" Height="450" CornerRadius="20" VerticalAlignment="Center" HorizontalAlignment="Center">

                <Border.Background>
                    <SolidColorBrush Color="White" Opacity="0.85"/>
                </Border.Background>

                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="20" ShadowDepth="5"/>
                </Border.Effect>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">

                    <!-- Logo: Altura aumentada significativamente para 180 -->
                    <Image Source="/Assets/Images/Logo.png" Height="180" Margin="0,0,0,10" Stretch="Uniform"/>

                    <TextBlock Text="Bem-vindos" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource CorTextoPrincipal}" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="Precificação inteligente&#x0A;para impressões 3D." FontSize="16" Foreground="{StaticResource CorTextoSecundario}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,40"/>

                    <!-- Botão -->
                    <Button Style="{StaticResource BotaoPrincipalStyle}" Width="250" Height="45" Click="BotaoEntrar_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Entrar no sistema" Margin="0,0,10,0"/>
                            <TextBlock Text="➔" FontSize="16"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>ss