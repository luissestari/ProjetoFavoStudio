<Window x:Class="FavoStudio3D.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Favo Studio 3D - Boas-vindas" Height="720" Width="1100"
        MinWidth="1100" MinHeight="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <!-- Grid Principal com a imagem de fundo RESPONSIVA -->
    <Grid>
        <Grid.Background>
            <!-- UniformToFill garante a responsividade. AlignmentX e Y centralizam o foco -->
            <ImageBrush ImageSource="/Assets/Images/ImagemTelaInicio.png" 
                        Stretch="UniformToFill" 
                        AlignmentX="Center" 
                        AlignmentY="Center"/>
        </Grid.Background>

        <!-- Container do Card -->
        <Border Width="480" Height="520" 
                CornerRadius="20" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Right" 
                Margin="0,0,220,0" 
                BorderBrush="#D4AF37" 
                BorderThickness="1">

            <Border.Background>
                <SolidColorBrush Color="White" Opacity="0.50"/>
            </Border.Background>

            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="25" ShadowDepth="8"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="35">

                <!-- Logo -->
                <Image Source="/Assets/Images/Logo.png" Height="170" Margin="0,0,0,10" Stretch="Uniform"/>

                <TextBlock Text="Bem-vindos" 
                           FontSize="48" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource CorTextoPrincipal}" 
                           HorizontalAlignment="Center" 
                           Margin="0,5,0,1"/>

                <TextBlock Text="Precificação inteligente&#x0A;para impressões 3D." 
                           FontSize="24" 
                           Foreground="{StaticResource CorTextoSecundario}" 
                           HorizontalAlignment="Center" 
                           TextAlignment="Center" 
                           Margin="0,0,0,45"/>

                <!-- Botão -->
                <Button Style="{StaticResource BotaoPrincipalStyle}" 
                        Width="380" Height="59" 
                        BorderBrush="#E5C158" 
                        BorderThickness="1" 
                        Click="BotaoEntrar_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Ajustes de alinhamento vertical e margens para centralização perfeita -->
                        <TextBlock Text="Entrar no sistema" Margin="0,0,12,0" FontSize="20" VerticalAlignment="Center" Padding="0,0,0,4"/>
                        <TextBlock Text="➔" FontSize="22" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>