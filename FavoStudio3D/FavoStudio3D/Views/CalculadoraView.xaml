<UserControl x:Class="FavoStudio3D.Views.CalculadoraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="680" d:DesignWidth="950"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style TargetType="ListBoxItem" x:Key="EstiloItemLista">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFF5E9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FCEBD3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Margem superior ligeiramente reduzida para ganhar espaço no ecrã -->
        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Left" Margin="40,10,0,15">

            <!-- PADDING INTERNO REDUZIDO: 30 nas laterais, 20 em cima e em baixo -->
            <Border Width="920" CornerRadius="20" Padding="30,20,30,20" VerticalAlignment="Stretch">
                <Border.Background>
                    <SolidColorBrush Color="White" Opacity="0.75"/>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="45" ShadowDepth="0"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <!-- Empurra os botões para o fundo, se houver espaço -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- LINHA 0: NOME E DESCRIÇÃO -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="240"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="#3E2723" Margin="0,0,0,4">
                                    Nome do produto <Run Text="*" Foreground="#D32F2F"/>
                                </TextBlock>
                                <!-- Altura dos inputs ajustada para 34 -->
                                <Border BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="8" Background="White" Height="34" Padding="12,0">
                                    <Grid>
                                        <TextBlock Text="Ex: Chaveiro Favo" Foreground="#A99F96" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtNomeProduto}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox x:Name="TxtNomeProduto" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Foreground="#3E2723" FontSize="12"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="#3E2723" Margin="0,0,0,4">Descrição</TextBlock>
                                <!-- Altura da Descrição bastante reduzida (de 72 para 55) para poupar espaço -->
                                <Border BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="8" Background="White" Height="55" Padding="12,6">
                                    <Grid>
                                        <TextBlock Text="Descreva seu produto..." Foreground="#A99F96" FontSize="12" VerticalAlignment="Top" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtDescricao}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox x:Name="TxtDescricao" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" Foreground="#3E2723" FontSize="12"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Box de Imagem reduzida (Height 110) -->
                        <Grid Grid.Column="2" Cursor="Hand" Height="110" Width="200" VerticalAlignment="Bottom">
                            <Rectangle Stroke="#C7BCAE" StrokeThickness="1.5" StrokeDashArray="4 4" RadiusX="12" RadiusY="12" Fill="#FFFBF5"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="/Assets/Images/IconeUploadImagem.png" Height="36" Margin="0,0,0,6" Stretch="Uniform"/>
                                <TextBlock Text="Adicionar imagem" FontSize="13" FontWeight="Bold" Foreground="#3E2723" TextAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="PNG, JPG OU WEBP (máx. 5 MB)" FontSize="9" Foreground="#A99F96" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Margem das divisórias reduzida -->
                    <Rectangle Grid.Row="1" Height="1" Fill="#EADCC9" Margin="0,10,0,10"/>

                    <!-- LINHA 2: TÍTULO PARÂMETROS -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#F4DDB5" Margin="0,0,10,0">
                            <Image Source="/Assets/Images/IconeParametros.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Parâmetros de cálculo" FontSize="15" FontWeight="Bold" Foreground="#3E2723"/>
                            <TextBlock Text="Limpe os campos ou calcule o custo e o preço de venda" FontSize="11" Foreground="#A99F96"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- LINHA 3: CAMPOS DE CÁLCULO -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Espaçamento entre as linhas de cálculo reduzido para 8 -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ================= LINHA A ================= -->
                        <Grid Grid.Row="0" Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Image Source="/Assets/Images/IconeFilamentoForm.png" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="#3E2723" VerticalAlignment="Center">
                                    Filamento <Run Text="*" Foreground="#D32F2F"/>
                                </TextBlock>
                            </StackPanel>
                            <!-- Altura do input 34 -->
                            <ToggleButton x:Name="BtnAbrirFilamento" Grid.Row="1" Height="34" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="6" Background="White" Padding="10,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TxtFilamentoSelecionado" Text="Selecione o filamento" Foreground="#A99F96" FontSize="12" VerticalAlignment="Center"/>
                                                <Image Grid.Column="1" Source="/Assets/Images/IconeSetaDropdown.png" Height="12" Width="12" Stretch="Uniform" VerticalAlignment="Center" Opacity="0.5"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsChecked, ElementName=BtnAbrirFilamento}" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnAbrirFilamento}" Placement="Bottom" VerticalOffset="2" AllowsTransparency="True">
                                <Border Background="White" CornerRadius="6" Padding="5" Margin="5" Width="260" BorderBrush="#EADCC9" BorderThickness="1" MaxHeight="200">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.10" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <ListBox x:Name="ListaFilamentos" BorderThickness="0" Background="Transparent" SelectionChanged="ListaFilamentos_SelectionChanged" ItemContainerStyle="{StaticResource EstiloItemLista}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" Foreground="#3E2723" FontSize="12"/>
                                                    <TextBlock Text="{Binding Material}" Foreground="#A99F96" FontSize="10"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                            <!-- Reserva das tags (reduzida para 24) -->
                            <Border Grid.Row="2" MinHeight="24" Margin="0,4,0,0"/>
                        </Grid>

                        <Grid Grid.Row="0" Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Image Source="/Assets/Images/IconeImpressoraForm.png" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="#3E2723" VerticalAlignment="Center">
                                    Tipo de impressora <Run Text="*" Foreground="#D32F2F"/>
                                </TextBlock>
                            </StackPanel>
                            <ToggleButton x:Name="BtnAbrirImpressora" Grid.Row="1" Height="34" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="6" Background="White" Padding="10,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TxtImpressoraSelecionada" Text="Selecione a impressora" Foreground="#A99F96" FontSize="12" VerticalAlignment="Center"/>
                                                <Image Grid.Column="1" Source="/Assets/Images/IconeSetaDropdown.png" Height="12" Width="12" Stretch="Uniform" VerticalAlignment="Center" Opacity="0.5"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsChecked, ElementName=BtnAbrirImpressora}" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnAbrirImpressora}" Placement="Bottom" VerticalOffset="2" AllowsTransparency="True">
                                <Border Background="White" CornerRadius="6" Padding="5" Margin="5" Width="260" BorderBrush="#EADCC9" BorderThickness="1" MaxHeight="200">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.10" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <ListBox x:Name="ListaImpressoras" BorderThickness="0" Background="Transparent" SelectionChanged="ListaImpressoras_SelectionChanged" ItemContainerStyle="{StaticResource EstiloItemLista}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" Foreground="#3E2723" FontSize="12"/>
                                                    <TextBlock Text="{Binding Modelo}" Foreground="#A99F96" FontSize="10"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                            <Border Grid.Row="2" MinHeight="24" Margin="0,4,0,0"/>
                        </Grid>

                        <Grid Grid.Row="0" Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Image Source="/Assets/Images/IconeCustoAdicional.png" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="#3E2723" VerticalAlignment="Center">
                                    Custo adicional (R$)
                                </TextBlock>
                            </StackPanel>
                            <ToggleButton x:Name="BtnAbrirCustosAdicionais" Grid.Row="1" Height="34" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="6" Background="White" Padding="10,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Selecione os custos" Foreground="#A99F96" FontSize="12" VerticalAlignment="Center"/>
                                                <Image Grid.Column="1" Source="/Assets/Images/IconeSetaDropdown.png" Height="12" Width="12" Stretch="Uniform" VerticalAlignment="Center" Opacity="0.5"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsChecked, ElementName=BtnAbrirCustosAdicionais}" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnAbrirCustosAdicionais}" Placement="Bottom" VerticalOffset="2" AllowsTransparency="True">
                                <Border Background="White" CornerRadius="6" Padding="5" Margin="5" Width="260" BorderBrush="#EADCC9" BorderThickness="1" MaxHeight="200">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.10" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <ListBox x:Name="ListaCustosAdicionais" BorderThickness="0" Background="Transparent" SelectionChanged="ListaCustosAdicionais_SelectionChanged" ItemContainerStyle="{StaticResource EstiloItemLista}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                        <TextBlock Text="{Binding Descricao}" FontWeight="SemiBold" Foreground="#3E2723" FontSize="12" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Valor, StringFormat=R$ \{0:N2\}}" Foreground="#A99F96" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="✔" Foreground="#4CAF50" FontWeight="Bold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding CheckVisivel, FallbackValue=Collapsed}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                            <!-- WrapPanel de tags com altura ajustada -->
                            <WrapPanel x:Name="PainelTagsCustos" Grid.Row="2" Margin="0,4,0,0" MinHeight="24"/>
                        </Grid>

                        <!-- ================= LINHA B ================= -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Image Source="/Assets/Images/IconePeso.png" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="#3E2723" VerticalAlignment="Center">
                                    Peso da peça (g) <Run Text="*" Foreground="#D32F2F"/>
                                </TextBlock>
                            </StackPanel>
                            <Border BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="6" Background="White" Height="34" Padding="10,0">
                                <Grid>
                                    <TextBlock Text="Ex: 50" Foreground="#A99F96" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtPeso}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="TxtPeso" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Foreground="#3E2723" FontSize="12"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Image Source="/Assets/Images/IconeTempo.png" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="#3E2723" VerticalAlignment="Center">
                                    Tempo de impressão <Run Text="*" Foreground="#D32F2F"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <!-- HORAS -->
                                <Border BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="6" Height="34" Width="100" Margin="0,0,15,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="White" Grid.Column="0" CornerRadius="5,0,0,5" Padding="8,0">
                                            <Grid>
                                                <TextBlock Text="Ex.: 2" Foreground="#A99F96" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=TxtHoras}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox x:Name="TxtHoras" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" TextAlignment="Left" Foreground="#3E2723" FontSize="12"/>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" Background="#FBF6F0" BorderBrush="#EADCC9" BorderThickness="1,0,0,0" CornerRadius="0,5,5,0" Padding="12,0">
                                            <TextBlock Text="h" FontWeight="Bold" Foreground="#3E2723" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- MINUTOS -->
                                <Border BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="6" Height="34" Width="110">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="White" Grid.Column="0" CornerRadius="5,0,0,5" Padding="8,0">
                                            <Grid>
                                                <TextBlock Text="Ex.: 30" Foreground="#A99F96" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=TxtMinutos}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox x:Name="TxtMinutos" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" TextAlignment="Left" Foreground="#3E2723" FontSize="12"/>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" Background="#FBF6F0" BorderBrush="#EADCC9" BorderThickness="1,0,0,0" CornerRadius="0,5,5,0" Padding="10,0">
                                            <TextBlock Text="min" FontWeight="Bold" Foreground="#3E2723" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Image Source="/Assets/Images/IconeCustoFixo.png" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="#3E2723" VerticalAlignment="Center">
                                    Custos fixos (R$) <Run Text="*" Foreground="#D32F2F"/>
                                </TextBlock>
                            </StackPanel>
                            <Border BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="6" Background="#FFF6BE" Height="34" Padding="10,0">
                                <TextBlock x:Name="TxtCustosFixos" Text="Calculado automaticamente" Foreground="#A99F96" FontSize="12" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- ================= LINHA C ================= -->
                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Image Source="/Assets/Images/IconeQuantidade.png" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="#3E2723" VerticalAlignment="Center">
                                    Quantidade <Run Text="*" Foreground="#D32F2F"/>
                                </TextBlock>
                            </StackPanel>
                            <Border BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="6" Background="White" Height="34" Padding="10,0">
                                <TextBox x:Name="TxtQuantidade" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Foreground="#3E2723" FontSize="12" Text="1"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Image Source="/Assets/Images/IconeAcabamento.png" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="#3E2723" VerticalAlignment="Center">
                                    Tipo de acabamento <Run Text="*" Foreground="#D32F2F"/>
                                </TextBlock>
                            </StackPanel>
                            <ToggleButton x:Name="BtnAbrirAcabamento" Height="34" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="6" Background="White" Padding="10,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TxtAcabamentoSelecionado" Text="Selecione o acabamento" Foreground="#A99F96" FontSize="12" VerticalAlignment="Center"/>
                                                <Image Grid.Column="1" Source="/Assets/Images/IconeSetaDropdown.png" Height="12" Width="12" Stretch="Uniform" VerticalAlignment="Center" Opacity="0.5"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsChecked, ElementName=BtnAbrirAcabamento}" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnAbrirAcabamento}" Placement="Bottom" VerticalOffset="2" AllowsTransparency="True">
                                <Border Background="White" CornerRadius="6" Padding="5" Margin="5" Width="260" BorderBrush="#EADCC9" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.10" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <ListBox x:Name="ListaAcabamento" BorderThickness="0" Background="Transparent" SelectionChanged="ListaAcabamento_SelectionChanged" ItemContainerStyle="{StaticResource EstiloItemLista}">
                                        <ListBoxItem Content="Brilhoso" Foreground="#3E2723" FontSize="12"/>
                                        <ListBoxItem Content="Fosco" Foreground="#3E2723" FontSize="12"/>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Image Source="/Assets/Images/IconeMargem.png" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="#3E2723" VerticalAlignment="Center">
                                    Margem de lucro (%) <Run Text="*" Foreground="#D32F2F"/>
                                </TextBlock>
                            </StackPanel>
                            <Border BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="6" Background="White" Height="34" Padding="10,0">
                                <Grid>
                                    <TextBlock Text="Ex: 50" Foreground="#A99F96" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtMargem}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="TxtMargem" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Foreground="#3E2723" FontSize="12"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="4"/>

                    <Rectangle Grid.Row="5" Height="1" Fill="#EADCC9" Margin="0,10,0,10"/>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <!-- Altura do botão levemente reduzida para 38 -->
                        <Button Width="130" Height="38" Margin="0,0,15,0" Cursor="Hand" Click="BtnLimpar_Click" BorderThickness="0" Background="Transparent">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" BorderBrush="#EBB45D" BorderThickness="2" CornerRadius="8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="/Assets/Images/IconeLimpar.png" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Limpar" Foreground="#3E2723" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Width="150" Height="38" Cursor="Hand" Click="BtnCalcular_Click" BorderThickness="0" Background="Transparent">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#EBB45D" CornerRadius="8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="/Assets/Images/IconeCalcular.png" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Calcular" Foreground="#3E2723" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ModalValidacao" Visibility="Collapsed" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="16" Padding="30" Width="400">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.15" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Atenção" FontSize="20" FontWeight="Bold" Foreground="#3E2723" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <TextBlock FontSize="15" Foreground="#795548" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,30">
                        <Run Text="Por favor, preencha todos os campos obrigatórios marcados com ("/>
                        <Run Text="*" Foreground="#D32F2F" FontWeight="Bold"/>
                        <Run Text=")."/>
                    </TextBlock>
                    <Button Height="45" Width="150" Background="#EBB45D" BorderThickness="0" Cursor="Hand" Click="BtnFecharValidacao_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <TextBlock Text="OK" Foreground="#3E2723" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>