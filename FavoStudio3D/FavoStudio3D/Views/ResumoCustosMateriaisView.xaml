<UserControl x:Class="FavoStudio3D.Views.ResumoCustosMateriaisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Margin="40,20,40,20">
        <Grid.ColumnDefinitions>
            <!-- Coluna 1: Filamentos -->
            <ColumnDefinition Width="*"/>
            <!-- Espaço entre os cartões -->
            <ColumnDefinition Width="30"/>
            <!-- Coluna 2: Outros Custos -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- CARTÃO 1: FILAMENTOS                       -->
        <!-- ========================================== -->
        <Border Grid.Column="0" CornerRadius="20" Padding="25" Background="#FFFFFF" Opacity="0.95">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.10" BlurRadius="30" ShadowDepth="0"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Cabeçalho -->
                    <RowDefinition Height="Auto"/>
                    <!-- Pesquisa e Filtro -->
                    <RowDefinition Height="Auto"/>
                    <!-- Títulos da Tabela -->
                    <RowDefinition Height="*"/>
                    <!-- Lista de Itens -->
                    <RowDefinition Height="Auto"/>
                    <!-- Paginação -->
                </Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <Grid Grid.Row="0" Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="45" Height="45" Fill="#F4DDB5" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <Image Grid.Column="0" Source="/Assets/Images/IconeAbaFilamento.png" Width="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,15,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Filamentos" FontSize="20" FontWeight="Bold" Foreground="#3E2723"/>
                        <TextBlock Text="Cadastre, visualize e gerencie os filamentos utilizados." FontSize="12" Foreground="#795548" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Botão Novo Filamento (CORRIGIDO PARA SUPORTAR CORNERRADIUS) -->
                    <Button Grid.Column="2" Background="#EBB45D" BorderThickness="0" Cursor="Hand" Click="BtnNovoFilamento_Click" VerticalAlignment="Top">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="15,8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="#3E2723" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Novo filamento" FontSize="13" FontWeight="Bold" Foreground="#3E2723" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Pesquisa e Filtro -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="White" Height="38" Padding="10,0">
                        <Grid>
                            <TextBlock Text="🔍 Pesquisar filamento..." Foreground="#A99F96" FontSize="13" VerticalAlignment="Center" Margin="25,0,0,0" IsHitTestVisible="False"/>
                            <TextBox Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Foreground="#3E2723" FontSize="13" Margin="25,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="White" Height="38" Padding="10,0" Cursor="Hand">
                        <Grid>
                            <TextBlock Text="Todos os tipos" Foreground="#795548" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="⌄" Foreground="#795548" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-5,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Títulos da Tabela -->
                <Border Grid.Row="2" Background="#FDF8F0" CornerRadius="8" Padding="15,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/>
                            <!-- Nome -->
                            <ColumnDefinition Width="1.5*"/>
                            <!-- Tipo -->
                            <ColumnDefinition Width="1*"/>
                            <!-- Cor -->
                            <ColumnDefinition Width="2*"/>
                            <!-- Preço -->
                            <ColumnDefinition Width="1*"/>
                            <!-- Ações -->
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nome" FontWeight="Bold" Foreground="#795548" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="Tipo" FontWeight="Bold" Foreground="#795548" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Cor" FontWeight="Bold" Foreground="#795548" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Preço (R$/kg)" FontWeight="Bold" Foreground="#795548" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="Ações" FontWeight="Bold" Foreground="#795548" FontSize="12" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Lista de Filamentos (ItemsControl ligado ao C#) -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ListaFilamentos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="15,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Nome da Cor com a bolinha colorida do lado -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Fill="{Binding CorHex}" Stroke="#E0E0E0" StrokeThickness="1" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Nome}" Foreground="#3E2723" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <!-- Badge de Tipo (Com cor dinâmica) -->
                                        <Border Grid.Column="1" Background="{Binding CorFundoTipo}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Tipo}" Foreground="#3E2723" FontSize="11" FontWeight="Bold"/>
                                        </Border>

                                        <Ellipse Grid.Column="2" Width="16" Height="16" Fill="{Binding CorHex}" Stroke="#E0E0E0" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3" Text="{Binding PrecoFormatado}" Foreground="#3E2723" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- Botão Três Pontinhos (Ações) -->
                                        <TextBlock Grid.Column="4" Text="⋮" FontSize="20" FontWeight="Bold" Foreground="#3E2723" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="MenuAcoesFilamento_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Paginação -->
                <Grid Grid.Row="4" Margin="0,20,0,0">
                    <TextBlock Text="11 filamentos cadastrados" Foreground="#A99F96" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Width="25" Height="25" Background="White" Margin="0,0,5,0" Cursor="Hand">
                            <TextBlock Text="&lt;" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#795548"/>
                        </Border>
                        <Border Background="#EBB45D" CornerRadius="4" Width="25" Height="25" Margin="0,0,5,0">
                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#3E2723" FontWeight="Bold"/>
                        </Border>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Width="25" Height="25" Background="White" Cursor="Hand">
                            <TextBlock Text="&gt;" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#795548"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>


        <!-- ========================================== -->
        <!-- CARTÃO 2: OUTROS CUSTOS                    -->
        <!-- ========================================== -->
        <Border Grid.Column="2" CornerRadius="20" Padding="25" Background="#FFFFFF" Opacity="0.95">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.10" BlurRadius="30" ShadowDepth="0"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <Grid Grid.Row="0" Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="45" Height="45" Fill="#F4DDB5" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <Image Grid.Column="0" Source="/Assets/Images/IconeAbaCusto.png" Width="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,15,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Outros custos" FontSize="20" FontWeight="Bold" Foreground="#3E2723"/>
                        <TextBlock Text="Adicione e gerencie os custos extras." FontSize="12" Foreground="#795548" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Botão Novo Custo (CORRIGIDO PARA SUPORTAR CORNERRADIUS) -->
                    <Button Grid.Column="2" Background="#EBB45D" BorderThickness="0" Cursor="Hand" Click="BtnNovoCusto_Click" VerticalAlignment="Top">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="15,8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="#3E2723" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Novo custo" FontSize="13" FontWeight="Bold" Foreground="#3E2723" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Pesquisa e Filtro -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="White" Height="38" Padding="10,0">
                        <Grid>
                            <TextBlock Text="🔍 Pesquisar custo..." Foreground="#A99F96" FontSize="13" VerticalAlignment="Center" Margin="25,0,0,0" IsHitTestVisible="False"/>
                            <TextBox Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Foreground="#3E2723" FontSize="13" Margin="25,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Background="White" Height="38" Padding="10,0" Cursor="Hand">
                        <Grid>
                            <TextBlock Text="Todos os tipos" Foreground="#795548" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="⌄" Foreground="#795548" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-5,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Títulos da Tabela -->
                <Border Grid.Row="2" Background="#FDF8F0" CornerRadius="8" Padding="15,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Descrição" FontWeight="Bold" Foreground="#795548" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="Valor (R$)" FontWeight="Bold" Foreground="#795548" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Tipo" FontWeight="Bold" Foreground="#795548" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Ações" FontWeight="Bold" Foreground="#795548" FontSize="12" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Lista de Custos (ItemsControl) -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ListaOutrosCustos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="15,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Descricao}" Foreground="#3E2723" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1" Text="{Binding ValorFormatado}" Foreground="#3E2723" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- Badge de Tipo (Fixo ou Adicional) -->
                                        <Border Grid.Column="2" Background="{Binding CorFundoTipo}" CornerRadius="4" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Tipo}" Foreground="#3E2723" FontSize="11" FontWeight="Bold"/>
                                        </Border>

                                        <!-- Botão Três Pontinhos -->
                                        <TextBlock Grid.Column="3" Text="⋮" FontSize="20" FontWeight="Bold" Foreground="#3E2723" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="MenuAcoesCusto_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Paginação -->
                <Grid Grid.Row="4" Margin="0,20,0,0">
                    <TextBlock Text="7 custos cadastrados" Foreground="#A99F96" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Width="25" Height="25" Background="White" Margin="0,0,5,0" Cursor="Hand">
                            <TextBlock Text="&lt;" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#795548"/>
                        </Border>
                        <Border Background="#EBB45D" CornerRadius="4" Width="25" Height="25" Margin="0,0,5,0">
                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#3E2723" FontWeight="Bold"/>
                        </Border>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Width="25" Height="25" Background="White" Cursor="Hand">
                            <TextBlock Text="&gt;" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#795548"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>