<UserControl x:Class="FavoStudio3D.Views.CalculadoraBloqueadaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="600">

    <Border Width="600" Height="500" CornerRadius="25" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border.Background>
            <SolidColorBrush Color="White" Opacity="0.70"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="45" ShadowDepth="0"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="50">
            <Image Source="/Assets/Images/IconeAviso.png" Height="125" Margin="0,0,0,25" Stretch="Uniform"/>
            <TextBlock Text="Configure os dados antes&#x0A;de usar a calculadora" 
                       FontSize="30" FontWeight="Bold" Foreground="#3E2723" 
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="Para utilizar a calculadora, cadastre primeiro as&#x0A;impressoras, os filamentos e os custos utilizados&#x0A;nas impressões." 
                       FontSize="20" Foreground="#3E2723" 
                       HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>