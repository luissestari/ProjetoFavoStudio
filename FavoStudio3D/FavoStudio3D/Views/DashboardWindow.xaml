<Window x:Class="FavoStudio3D.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Favo Studio 3D - Calculadora" 
        Height="720" Width="1100"
        MinWidth="1100" MinHeight="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Images/FundoDashboard.png" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
        </Grid.Background>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- MENU LATERAL -->
            <Border Grid.Column="0" Width="120" Margin="25,25,0,25" CornerRadius="20">
                <Border.Background>
                    <SolidColorBrush Color="White" Opacity="0.60"/>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="30" ShadowDepth="0"/>
                </Border.Effect>

                <Grid>
                    <StackPanel Margin="0,35,0,0" HorizontalAlignment="Center">

                        <!-- Logo Miniatura -->
                        <Image Source="/Assets/Images/LogoMini.png" Height="75" Margin="0,0,0,30" Stretch="Uniform"/>

                        <!-- Botão: Calculadora (Inicia Ativo) -->
                        <Border x:Name="MenuCalculadoraBorder" Background="#F3D09E" CornerRadius="12" Width="98" Height="77" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonUp="BotaoMenuCalculadora_Click">
                            <StackPanel VerticalAlignment="Center">
                                <Image Source="/Assets/Images/IconeCalculadora.png" Height="26" Margin="0,0,0,8" Stretch="Uniform"/>
                                <TextBlock x:Name="MenuCalculadoraTexto" Text="Calculadora" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#4A2A1A"/>
                            </StackPanel>
                        </Border>

                        <!-- Botão: Custos e Materiais -->
                        <Border x:Name="MenuCustosBorder" Background="Transparent" CornerRadius="12" Width="98" Height="77" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonUp="BotaoMenuCustos_Click">
                            <StackPanel VerticalAlignment="Center">
                                <Image Source="/Assets/Images/IconeCustos.png" Height="26" Margin="0,0,0,8" Stretch="Uniform"/>
                                <TextBlock x:Name="MenuCustosTexto" Text="Custos e materiais" FontSize="12" FontWeight="Normal" HorizontalAlignment="Center" Foreground="#4A2A1A" TextAlignment="Center" TextWrapping="Wrap" Width="68"/>
                            </StackPanel>
                        </Border>

                        <!-- Botão: Produtos (Preparado para o futuro) -->
                        <Border x:Name="MenuProdutosBorder" Background="Transparent" CornerRadius="12" Width="98" Height="77" Margin="0,0,0,10" Cursor="Hand">
                            <StackPanel VerticalAlignment="Center">
                                <Image Source="/Assets/Images/IconeProdutos.png" Height="26" Margin="0,0,0,8" Stretch="Uniform"/>
                                <TextBlock x:Name="MenuProdutosTexto" Text="Produtos" FontSize="12" FontWeight="Normal" HorizontalAlignment="Center" Foreground="#4A2A1A"/>
                            </StackPanel>
                        </Border>

                        <!-- Botão: Impressora (Preparado para o futuro) -->
                        <Border x:Name="MenuImpressoraBorder" Background="Transparent" CornerRadius="12" Width="98" Height="77" Margin="0,0,0,10" Cursor="Hand">
                            <StackPanel VerticalAlignment="Center">
                                <Image Source="/Assets/Images/IconeImpressora.png" Height="26" Margin="0,0,0,8" Stretch="Uniform"/>
                                <TextBlock x:Name="MenuImpressoraTexto" Text="Impressora" FontSize="12" FontWeight="Normal" HorizontalAlignment="Center" Foreground="#4A2A1A"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Botão Sair -->
                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,35" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="BotaoSair_Click">
                        <Image Source="/Assets/Images/IconeSair.png" Height="26" Margin="0,0,0,8" Stretch="Uniform"/>
                        <TextBlock Text="Sair" FontSize="11" HorizontalAlignment="Center" Foreground="#4A2A1A"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ÁREA DE CONTEÚDO PRINCIPAL -->
            <Grid Grid.Column="1" Margin="50,50,50,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TextoTituloPagina" Text="Calculadora" FontSize="42" FontWeight="Bold" Foreground="#3E2723"/>
                        <TextBlock x:Name="TextoSubtituloPagina" Text="Calcule os custos de produção e defina o preço de venda dos seus produtos 3D." FontSize="18" Foreground="#3E2723" Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <TextBlock x:Name="TextoData" Text="Sex, 16 de Outubro de 2026" FontSize="16" Foreground="#3E2723" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TextoHora" Text="14:32" FontSize="28" FontWeight="SemiBold" Foreground="#3E2723" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ÁREA DINÂMICA -->
                <ContentControl x:Name="AreaConteudo" Grid.Row="1" Margin="-50,15,0,0" />
            </Grid>
        </Grid>
    </Grid>
</Window>