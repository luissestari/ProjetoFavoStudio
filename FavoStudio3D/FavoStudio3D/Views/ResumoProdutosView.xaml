<UserControl x:Class="FavoStudio3D.Views.ResumoProdutosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="680" d:DesignWidth="950"
             Loaded="UserControl_Loaded">

    <Grid>
        <!-- GRANDE CARTÃO BRANCO ALINHADO À ESQUERDA - Altura aumentada para 580 -->
        <Border Width="880" Height="580" CornerRadius="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,0,0,0" Padding="35,25,35,20">
            <Border.Background>
                <SolidColorBrush Color="White" Opacity="0.75"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.10" BlurRadius="35" ShadowDepth="0"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. BARRA SUPERIOR: PESQUISA E BOTÃO NOVO CÁLCULO -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Caixa de Pesquisa com largura reduzida (Width="400") -->
                    <Border Grid.Column="0" Width="400" HorizontalAlignment="Left" Background="White" CornerRadius="10" Height="46" Padding="15,0" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.04" BlurRadius="10" ShadowDepth="1"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Assets/Images/IconePesquisa.png" Width="16" Height="16" Margin="0,0,12,0" Opacity="0.5" Stretch="Uniform"/>

                            <TextBox x:Name="TxtPesquisa" Grid.Column="1" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" 
                                     FontSize="14" Foreground="#3E2723" TextChanged="TxtPesquisa_TextChanged"/>

                            <!-- Texto de Placeholder dinâmico -->
                            <TextBlock Grid.Column="1" Text="Buscar produtos por nome, filamento..." 
                                       VerticalAlignment="Center" FontSize="14" Foreground="#A99F96" IsHitTestVisible="False" Margin="2,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtPesquisa}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Botão Novo Cálculo -->
                    <Button Grid.Column="2" Width="165" Height="46" Background="#EBB45D" BorderThickness="0" Cursor="Hand" Click="BtnNovoCalculo_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="/Assets/Images/BotaoMaisBranco.png" Height="20" Margin="0,0,8,0" Stretch="Uniform"/>
                                        <TextBlock Text="Novo cálculo" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- 2. CARTÃO BEGE DO CABEÇALHO DA TABELA -->
                <Border Grid.Row="1" Background="#FCEFD8" CornerRadius="10" Height="40" Margin="0,6,0,10" Padding="15,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Produto" FontSize="12" FontWeight="Bold" Foreground="#381300" Margin="5,0,0,0"/>
                        <TextBlock Grid.Column="1" Text="Filamento" FontSize="12" FontWeight="Bold" Foreground="#381300"/>
                        <!-- Espaço extra na impressora usando Margin -->
                        <TextBlock Grid.Column="2" Text="Impressora" FontSize="12" FontWeight="Bold" Foreground="#381300" Margin="30,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="Custo total" FontSize="12" FontWeight="Bold" Foreground="#381300"/>
                        <TextBlock Grid.Column="4" Text="Preço sugerido" FontSize="12" FontWeight="Bold" Foreground="#381300"/>
                        <TextBlock Grid.Column="5" Text="Ações" FontSize="12" FontWeight="Bold" Foreground="#381300" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 3. LISTA DE ITENS -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ListaProdutos">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="10" Height="62" Margin="0,0,0,8" Padding="12,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.03" BlurRadius="8" ShadowDepth="1"/>
                                    </Border.Effect>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*"/>
                                            <ColumnDefinition Width="1.8*"/>
                                            <ColumnDefinition Width="1.8*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Produto -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="6" Background="#FFFBF5" BorderBrush="#EADCC9" BorderThickness="1" Margin="0,0,10,0" ClipToBounds="True">
                                                <Image Source="{Binding CaminhoImagem}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nome}" FontSize="13" FontWeight="Bold" Foreground="#3E2723"/>
                                                <TextBlock Text="{Binding CodigoSku}" FontSize="10" Foreground="#A99F96" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Filamento -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Margin="0,0,10,0">
                                                <Ellipse Width="24" Height="24" Fill="White" Stroke="#EADCC9" StrokeThickness="1"/>
                                                <Ellipse Width="18" Height="18" Fill="{Binding CorFilamentoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FilamentoNome}" FontSize="13" FontWeight="Bold" Foreground="#3E2723"/>
                                                <TextBlock Text="{Binding FilamentoDetalhe}" FontSize="12" Foreground="#A99F96"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Impressora (Sem ícone e com margem maior para afastar da coluna Filamento) -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="30,0,0,0">
                                            <TextBlock Text="{Binding ImpressoraNome}" FontSize="12" FontWeight="SemiBold" Foreground="#3E2723"/>
                                            <TextBlock Text="{Binding ImpressoraModelo}" FontSize="10" Foreground="#A99F96"/>
                                        </StackPanel>

                                        <!-- Custo Total -->
                                        <TextBlock Grid.Column="3" Text="{Binding CustoTotalFormatado}" FontSize="13" FontWeight="Bold" Foreground="#3E2723" VerticalAlignment="Center"/>

                                        <!-- Preço Sugerido -->
                                        <TextBlock Grid.Column="4" Text="{Binding PrecoSugeridoFormatado}" FontSize="13" FontWeight="Bold" Foreground="#8D4925" VerticalAlignment="Center"/>

                                        <!-- Ações -->
                                        <Button Grid.Column="5" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="⋮" FontSize="16" FontWeight="Bold" Foreground="#795548"/>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Editar" Click="MenuEditar_Click"/>
                                                    <MenuItem Header="Excluir" Click="MenuExcluir_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 4. RODAPÉ / PAGINAÇÃO DINÂMICA -->
                <StackPanel Grid.Row="3" x:Name="PanelPaginacao" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
                    <!-- Gerado dinamicamente no C# conforme a quantidade de produtos -->
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>