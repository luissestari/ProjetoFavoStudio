<Window x:Class="FavoStudio3D.Views.NovaCorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova Cor" Height="400" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <!-- O Padding="30" foi movido do StackPanel para aqui -->
    <Border Width="400" Height="350" CornerRadius="20" Background="White" Margin="25" Padding="30">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.20" BlurRadius="30" ShadowDepth="0"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="Adicionar nova cor" FontSize="22" FontWeight="Bold" Foreground="#3E2723" HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <!-- Nome da Cor -->
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Nome da cor" FontSize="14" FontWeight="Bold" Foreground="#3E2723" Margin="0,0,0,8"/>
                <Border BorderBrush="#C7BCAE" BorderThickness="1" CornerRadius="6" Background="White" Height="40" Padding="12,0">
                    <Grid>
                        <TextBlock Text="Ex: Verde Musgo" Foreground="#A99F96" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtNomeCor}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="TxtNomeCor" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Foreground="#3E2723" FontSize="14"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Código Hexadecimal e Preview -->
            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Código Hexadecimal" FontSize="14" FontWeight="Bold" Foreground="#3E2723" Margin="0,0,0,8"/>
                    <Border BorderBrush="#C7BCAE" BorderThickness="1" CornerRadius="6" Background="White" Height="40" Padding="12,0">
                        <Grid>
                            <TextBlock Text="Ex: #4A5D23" Foreground="#A99F96" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtHex}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="TxtHex" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Foreground="#3E2723" FontSize="14" TextChanged="TxtHex_TextChanged"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Pré-visualização da Cor -->
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <Ellipse x:Name="PreviewCor" Width="32" Height="32" Stroke="#E0E0E0" StrokeThickness="1" Fill="Transparent"/>
                </StackPanel>
            </Grid>

            <!-- Botões -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Width="130" Height="40" Margin="0,0,15,0" Background="Transparent" BorderBrush="#EBB45D" BorderThickness="2" Cursor="Hand" Click="BtnCancelar_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <TextBlock Text="Cancelar" Foreground="#3E2723" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Width="130" Height="40" Background="#EBB45D" BorderThickness="0" Cursor="Hand" Click="BtnAdicionar_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <TextBlock Text="Adicionar" Foreground="#3E2723" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>