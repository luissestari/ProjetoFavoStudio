<Application x:Class="FavoStudio3D.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <!-- Cores Padrão Favo Studio 3D -->
        <SolidColorBrush x:Key="CorTextoPrincipal" Color="#4A2A1A"/>
        <SolidColorBrush x:Key="CorTextoSecundario" Color="#7B5F51"/>
        <SolidColorBrush x:Key="CorBotaoFundo" Color="#C88E4B"/>
        <SolidColorBrush x:Key="CorBotaoHover" Color="#A5733A"/>

        <!-- Estilo do Botão Principal -->
        <Style x:Key="BotaoPrincipalStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CorBotaoFundo}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CorBotaoHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>